# TiDB Serverless (MySQL-compatible)
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/kbss_dorms?sslaccept=strict"

# Session cookie encryption — run: openssl rand -hex 32
SESSION_SECRET="use-openssl-rand-hex-32-here"

# App base URL (no trailing slash)
APP_BASE_URL="http://localhost:3000"

# Resend (free tier) — for password reset emails
# Sign up at https://resend.com — free tier = 100 emails/day
RESEND_API_KEY="re_your_resend_api_key"
# The "From" address for password reset emails (must be a verified domain in Resend)
RESEND_FROM="noreply@yourdomain.com"
