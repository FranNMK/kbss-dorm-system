# TiDB Serverless (MySQL-compatible)
# Full connection string format for TiDB Cloud free tier:
# mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/kbss_dorms?sslaccept=strict"

# Auth0 — @auth0/nextjs-auth0 v4
# Get these from your Auth0 Dashboard > Applications > Your App
AUTH0_DOMAIN="YOUR_DOMAIN.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"

# Generated via: openssl rand -hex 32
AUTH0_SECRET="use-openssl-rand-hex-32-here"

# Base URL of this app (no trailing slash). Optional — SDK infers from request host if omitted.
APP_BASE_URL="http://localhost:3000"

# ── Auth0 Dashboard setup required ────────────────────────────────────────────
# Allowed Callback URLs:  http://localhost:3000/auth/callback
# Allowed Logout URLs:    http://localhost:3000
# ──────────────────────────────────────────────────────────────────────────────
