# TiDB Serverless (MySQL-compatible)
# Full connection string format for TiDB Cloud free tier:
# mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/kbss_dorms?sslaccept=strict"

# Auth0 — generated via: openssl rand -hex 32
AUTH0_SECRET="use-openssl-rand-hex-32-here"

# Base URL of this app (no trailing slash)
AUTH0_BASE_URL="http://localhost:3000"

# Your Auth0 tenant domain  e.g. https://dev-abc123.auth0.com
AUTH0_ISSUER_BASE_URL="https://YOUR_DOMAIN.auth0.com"

# Auth0 application credentials (Regular Web Application)
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
